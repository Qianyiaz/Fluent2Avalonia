<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="PublishWithSatoriGC" Version="11.0.0-satori.42242472725.2"/>
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Features>runtime-async=on</Features>
        <TargetFramework>net11.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
        <MetricsSupport>false</MetricsSupport>
        <IlcScanReflection>false</IlcScanReflection>
        <StackTraceSupport>false</StackTraceSupport>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <OptimizationPreference>Size</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Jab" PrivateAssets="All"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Fluent2Avalonia\Fluent2Avalonia.csproj"/>
    </ItemGroup>
</Project>