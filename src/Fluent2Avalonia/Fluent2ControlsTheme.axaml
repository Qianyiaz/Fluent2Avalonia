<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fluent2Avalonia.Fluent2ControlsTheme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Fluent2Avalonia.Icons/Controls/SymbolIconText.axaml" />
                <MergeResourceInclude Source="avares://Fluent2Avalonia/Controls/NavigationView.axaml" />
                <MergeResourceInclude Source="avares://Fluent2Avalonia/Controls/NavigationViewItem.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="WinSymbolsFont">avares://Fluent2Avalonia.Icons/Fonts/WinSymbols3.ttf#Symbols</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Fluent2Avalonia/Controls/NavigationViewButton.axaml" />
</Styles>